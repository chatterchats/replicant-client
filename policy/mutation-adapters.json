{
  "$schema_note": "Phase 11.6 typed managed mutation inventory. Every supported unsafe route is either exactly one managed typed adapter or an explicitly raw-only bootstrap endpoint.",
  "raw_only": [
    "POST /v1/accounts",
    "POST /v1/accounts/recover",
    "POST /v1/feedback"
  ],
  "managed": {
    "DELETE /v1/accounts/me": "AccountWipe",
    "DELETE /v1/devices/{device_code}/permissions": "DeviceRevokePermission",
    "DELETE /v1/devices/{device_code}/simulate/{sim_id}": "DeviceAbandonSimulation",
    "DELETE /v1/devices/{device_code}/trades/{trade_code}": "DeviceDeleteTrade",
    "DELETE /v1/replicants/{replicant_code}/mine": "ReplicantStopMining",
    "DELETE /v1/replicants/{replicant_code}/travel": "ReplicantCancelTravel",
    "PATCH /v1/accounts/me": "AccountUpdate",
    "PATCH /v1/devices/{device_code}": "DeviceConfigure",
    "PATCH /v1/replicants/{replicant_code}": "ReplicantUpdate",
    "POST /v1/devices/{device_code}": "DeviceCommand (DeviceDynamicCommand is the open-vocabulary form)",
    "POST /v1/devices/{device_code}/permissions": "DeviceGrantPermission",
    "POST /v1/devices/{device_code}/retrieve": "DeviceRetrieve",
    "POST /v1/devices/{device_code}/simulate": "DeviceEnterSimulation",
    "POST /v1/devices/{device_code}/trades": "DeviceCreateTrade",
    "POST /v1/devices/{device_code}/trades/{trade_code}": "DeviceFulfillTrade",
    "POST /v1/locations/{designation}/contribute": "LocationContribute",
    "POST /v1/locations/{location_code}/events/{designation}": "LocationEventResolve",
    "POST /v1/messages/read": "MessagesMarkRead",
    "POST /v1/replicants/{replicant_code}/message": "ReplicantMessage",
    "POST /v1/replicants/{replicant_code}/mine": "ReplicantMine",
    "POST /v1/replicants/{replicant_code}/print": "ReplicantPrint",
    "POST /v1/replicants/{replicant_code}/scan": "ReplicantScan",
    "POST /v1/replicants/{replicant_code}/teleport": "ReplicantTeleport",
    "POST /v1/replicants/{replicant_code}/transfer": "ReplicantTransfer",
    "POST /v1/replicants/{replicant_code}/travel": "ReplicantTravel"
  }
}
