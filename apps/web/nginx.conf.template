log_format replicant_web escape=json
    '{'
      '"timestamp":"$time_iso8601",'
      '"request_id":"$request_id",'
      '"remote_addr":"$remote_addr",'
      '"method":"$request_method",'
      '"uri":"$uri",'
      '"status":$status,'
      '"request_time_s":"$request_time",'
      '"upstream_connect_time_s":"$upstream_connect_time",'
      '"upstream_header_time_s":"$upstream_header_time",'
      '"upstream_response_time_s":"$upstream_response_time",'
      '"upstream_status":"$upstream_status",'
      '"request_bytes":$request_length,'
      '"response_bytes":$bytes_sent,'
      '"content_type":"$sent_http_content_type",'
      '"referer":"$http_referer",'
      '"user_agent":"$http_user_agent"'
    '}';

access_log /dev/stdout replicant_web;
error_log /dev/stderr warn;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass http://replicantd:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The daemon token is injected here, not shipped to the browser: a
        # value baked into the JS bundle would be readable by anyone who loads
        # the page and would need an image rebuild to rotate. Rendered from the
        # environment at container start by the nginx entrypoint's envsubst.
        proxy_set_header Authorization "Bearer ${REPLICANTD_TOKEN}";
        proxy_connect_timeout 5s;
        # Actions are started asynchronously and return immediately, so no
        # request should approach this; it stays generous for large
        # projections such as the galaxy scene.
        proxy_read_timeout 120s;

        # These same-origin diagnostics let the browser correlate its elapsed
        # fetch time with what nginx spent waiting on replicantd. Values are
        # nginx seconds and are converted to milliseconds by the frontend.
        add_header X-Replicant-Request-Id $request_id always;
        add_header X-Replicant-Upstream-Connect-Time $upstream_connect_time always;
        add_header X-Replicant-Upstream-Header-Time $upstream_header_time always;
        add_header X-Replicant-Upstream-Response-Time $upstream_response_time always;
    }

    location = /ws {
        proxy_pass http://replicantd:8080/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Authorization "Bearer ${REPLICANTD_TOKEN}";
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
