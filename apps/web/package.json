{
  "name": "@replicant/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run wasm:build && vite",
    "build": "npm run wasm:build && npm run build:web",
    "build:web": "tsc --noEmit && vite build",
    "wasm:build": "make -C ../.. galaxy-wasm",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run wasm:build && npm run format:check && npm run lint && npm run test && npm run build:web"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "prettier": "^3.8.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
