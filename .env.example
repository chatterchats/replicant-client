# Copy to .env and replace placeholders. Never commit the real file.
RS_API_TOKEN=replace-with-your-replicant-space-token

REPLICANT_PROFILE=default
REPLICANT_WEB_PORT=8080
REPLICANT_DATA_DIR=${HOME}/.local/share/replicant
REPLICANT_UID=1000
REPLICANT_GID=1000
RUST_LOG=info

# Used only with compose.secret.yaml; RS_API_TOKEN takes precedence otherwise.
# RS_API_TOKEN_FILE_HOST=/absolute/path/to/rs_api_token
# REPLICANTD_PORT=8080

# Shared secret for the daemon's HTTP and WebSocket API. Required whenever the
# daemon binds beyond loopback, which the Compose stack does. Run `make token`
# to generate one. The web container injects it server-side; it is never sent
# to the browser.
REPLICANTD_TOKEN=
